{
  "name": "invoice-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Gestion commerciale et facturation multi-entreprises — application web pour iPhone, données stockées uniquement sur l'appareil",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "preview": "cd frontend && npx vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p shared --noEmit && tsc -p backend --noEmit && tsc -p frontend --noEmit",
    "db:generate": "npm run db:generate -w backend"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@types/node": "24.10.1",
    "concurrently": "10.0.7",
    "drizzle-orm": "0.45.4",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
